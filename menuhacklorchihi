    swCorner.Parent = switch

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 18 * scale, 0, 18 * scale)
    dot.Position = defaultState and UDim2.new(1, -(21 * scale), 0.5, -(9 * scale)) or UDim2.new(0, 3 * scale, 0.5, -(9 * scale))
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
