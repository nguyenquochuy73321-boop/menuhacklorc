-- AIMBOT
runService.RenderStepped:Connect(function()
    if aimbotEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local cam = workspace.CurrentCamera
        local closestTarget = nil
        local maxDist = 250

        for _, p in pairs(players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local head = p.Character.Head
                local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if mouseDist < maxDist then
                        maxDist = mouseDist
                        closestTarget = head
                    end
                end
            end
        end

        if closestTarget then
            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, closestTarget.Position), aimbotSmoothness)
        end
    end
end)

-- SPEED & FLY
runService.RenderStepped:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum and hum.Health > 0 then
        hum.WalkSpeed = speedVal
    end

    if flyEnabled and hrp and hum then
        hum.PlatformStand = true
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.zero

        if userInput:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if userInput:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if userInput:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if userInput:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if userInput:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if userInput:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        hrp.Velocity = moveDir * (flySpeedVal * 4)
    end
end)

