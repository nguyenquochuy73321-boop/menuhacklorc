-- RENDER ESP LOOP
runService.RenderStepped:Connect(function()
    for p, esp in pairs(espStorage) do
        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
            local char = p.Character
            local hrp = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hum.Health > 0 then
                -- 1. Box Highlight
                if esp.Highlight then
                    esp.Highlight.Enabled = boxEspEnabled
                end

                -- 2. Text & Health Info
                if esp.Billboard then
                    esp.Billboard.Enabled = textEspEnabled or healthBarEnabled
                    esp.HealthBg.Visible = healthBarEnabled

                    local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    esp.HealthFill.Size = UDim2.new(hpPercent, 0, 1, 0)

                    if hpPercent > 0.6 then
                        esp.HealthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
                    elseif hpPercent > 0.3 then
                        esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    else
                        esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 40, 80)
                    end

                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude)
                        if textEspEnabled then
                            esp.Text.Text = string.format("<b>%s</b> <font color='#00FFCC'>[%dm]</font>\n<font color='#FF5078'>HP: %d%%</font>", p.DisplayName, dist, math.floor(hpPercent * 100))
                        else
                            esp.Text.Text = ""
                        end
                    end
                end

                -- 3. Tracers Line
                if tracerEspEnabled and esp.Tracer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        local targetPos = Vector2.new(hrpPos.X, hrpPos.Y)
                        local distance = (targetPos - screenBottom).Magnitude
                        local angle = math.deg(math.atan2(targetPos.Y - screenBottom.Y, targetPos.X - screenBottom.X))

                        esp.Tracer.Size = UDim2.new(0, distance, 0, 1.5)
                        esp.Tracer.Position = UDim2.new(0, (screenBottom.X + targetPos.X) / 2, 0, (screenBottom.Y + targetPos.Y) / 2)
                        esp.Tracer.Rotation = angle
                        esp.Tracer.Visible = true
                    else
                        esp.Tracer.Visible = false
                    end
                elseif esp.Tracer then
                    esp.Tracer.Visible = false
                end
            else
                if esp.Highlight then esp.Highlight.Enabled = false end
                if esp.Billboard then esp.Billboard.Enabled = false end
                if esp.Tracer then esp.Tracer.Visible = false end
            end
        else
            if esp.Highlight then esp.Highlight.Enabled = false end
            if esp.Billboard then esp.Billboard.Enabled = false end
            if esp.Tracer then esp.Tracer.Visible = false end
        end
    end
end)

