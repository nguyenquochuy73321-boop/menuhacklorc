local espStorage = {}

local function createPlayerEsp(p)
    if p == player then return end

    local function setupChar(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        local head = char:WaitForChild("Head", 5)
        if not hrp or not hum or not head then return end

        -- Highlight (Box ESP)
        local hl = Instance.new("Highlight")
        hl.Name = "EspHighlight"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(0, 255, 204)
        hl.FillTransparency = 0.85
        hl.OutlineColor = Color3.fromRGB(0, 255, 204)
        hl.OutlineTransparency = 0
        hl.Enabled = boxEspEnabled
        hl.Parent = espFolder

        -- Billboard Text Info & Healthbar
        local bb = Instance.new("BillboardGui")
        bb.Name = "EspBillboard"
        bb.Adornee = head
        bb.Size = UDim2.new(0, 200, 0, 60)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Enabled = textEspEnabled or healthBarEnabled
        bb.Parent = espFolder

        local textLbl = Instance.new("TextLabel")
        textLbl.Size = UDim2.new(1, 0, 0, 30)
        textLbl.BackgroundTransparency = 1
        textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLbl.TextStrokeTransparency = 0
        textLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLbl.Font = Enum.Font.GothamBold
        textLbl.TextSize = 12
        textLbl.RichText = true
        textLbl.Parent = bb

        local healthBgFrame = Instance.new("Frame")
        healthBgFrame.Size = UDim2.new(0, 80, 0, 5)
        healthBgFrame.Position = UDim2.new(0.5, -40, 1, -10)
        healthBgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        healthBgFrame.BorderSizePixel = 0
        healthBgFrame.Visible = healthBarEnabled
        healthBgFrame.Parent = bb

        local healthFillFrame = Instance.new("Frame")
        healthFillFrame.Size = UDim2.new(1, 0, 1, 0)
        healthFillFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        healthFillFrame.BorderSizePixel = 0
        healthFillFrame.Parent = healthBgFrame

        -- Tracers Line
        local tracerLine = Instance.new("Frame")
        tracerLine.AnchorPoint = Vector2.new(0.5, 0.5)
        tracerLine.BackgroundColor3 = Color3.fromRGB(0, 255, 204)
        tracerLine.BorderSizePixel = 0
        tracerLine.Visible = false
        tracerLine.Parent = gui

        espStorage[p] = {
            Highlight = hl,
            Billboard = bb,
            Text = textLbl,
            HealthBg = healthBgFrame,
            HealthFill = healthFillFrame,
            Tracer = tracerLine
        }
    end

    if p.Character then setupChar(p.Character) end
    p.CharacterAdded:Connect(setupChar)
end

local function removePlayerEsp(p)
    if espStorage[p] then
        for _, v in pairs(espStorage[p]) do
            if v and typeof(v) == "Instance" then v:Destroy() end
        end
        espStorage[p] = nil
    end
end

