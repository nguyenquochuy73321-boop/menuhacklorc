local function pressHotbarSlot(slot)
    pcall(function()
        local keyCode = keyCodes[slot]
        if keyCode then
            vim:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.01)
            vim:SendKeyEvent(false, keyCode, false, game)
        end

        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local hotbar = playerGui:FindFirstChild("Hotbar") or playerGui:FindFirstChild("Inventory") or playerGui:FindFirstChild("MainGui")
            if hotbar then
                local slotBtn = hotbar:FindFirstChild(tostring(slot), true) or hotbar:FindFirstChild("Slot" .. tostring(slot), true)
                if slotBtn and slotBtn:IsA("GuiButton") then
                    for _, conn in pairs(getconnections(slotBtn.MouseButton1Click)) do
                        conn:Fire()
                    end
                end
            end
        end
    end)
end

