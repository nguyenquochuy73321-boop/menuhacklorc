-- SYSTEM 1: HOTBAR AUTO HEAL (SLOT 1 TO 5)
-- ===================================================================

local function doHotbarHeal()
    if not autoHealEnabled or isHealDebounce then return end

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local healthPercent = (hum.Health / hum.MaxHealth) * 100
    if healthPercent >= healHealthThreshold then return end

    isHealDebounce = true
    isCurrentlyHealing = true

    task.spawn(function()
        pcall(function()
            -- Bấm phím / Nút Hotbar để chuyển sang ô máu
            pressHotbarSlot(healSlotNumber)
            task.wait(0.05)

            -- Bấm chuột / chạm màn hình để dùng máu
            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.02)
            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)

            task.wait(0.15)
        end)

        isCurrentlyHealing = false
        task.wait(0.1)
        isHealDebounce = false
    end)
end

task.spawn(function()
    while task.wait(0.05) do
        pcall(function()
            if autoHealEnabled and not isHealDebounce then
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if ((hum.Health / hum.MaxHealth) * 100) < healHealthThreshold then
                            doHotbarHeal()
                        end
                    end
                end
            end
        end)
    end
end)

-- ===================================================================
-- SYSTEM 2: SMART AUTO ATTACK (KHÔNG CẦN CHỌN Ô)
-- ===================================================================

task.spawn(function()
    while task.wait(0.08) do
        pcall(function()
            if not autoAttackEnabled or isCurrentlyHealing or isHealDebounce then return end

            local char = player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or hum.Health <= 0 or not hrp then return end

            local closestTarget = nil
            local minDistance = attackRange

            for _, p in pairs(players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                    if p.Character.Humanoid.Health > 0 then
                        local enemyHrp = p.Character.HumanoidRootPart
                        local dist = (enemyHrp.Position - hrp.Position).Magnitude
                        if dist < minDistance then
                            minDistance = dist
                            closestTarget = enemyHrp
                        end
                    end
                end
            end

            if closestTarget then
                if not spinEnabled then
                    hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(closestTarget.Position.X, hrp.Position.Y, closestTarget.Position.Z))
                end

                -- Tự động kích hoạt đòn đánh dựa theo món vũ khí đang cầm trên tay
                local activeTool = char:FindFirstChildOfClass("Tool")
                if activeTool then
                    activeTool:Activate()
                else
                    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.01)
                    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            end
        end)
    end
end)

