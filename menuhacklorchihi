        bbGui.Enabled = false
        bbGui.Parent = espFolder

        local nameTxt = bbGui:FindFirstChild("NameTxt") or Instance.new("TextLabel")
        nameTxt.Name = "NameTxt"
        nameTxt.Size = UDim2.new(1, 0, 0.5, 0)
        nameTxt.BackgroundTransparency = 1
        nameTxt.TextColor3 = Color3.fromRGB(0, 255, 204)
        nameTxt.TextStrokeTransparency = 0.2
        nameTxt.Font = Enum.Font.GothamBold
        nameTxt.TextSize = 13 * scale
        nameTxt.Parent = bbGui

        local hpTxt = bbGui:FindFirstChild("HpTxt") or Instance.new("TextLabel")
        hpTxt.Name = "HpTxt"
        hpTxt.Size = UDim2.new(1, 0, 0.5, 0)
        hpTxt.Position = UDim2.new(0, 0, 0.5, 0)
        hpTxt.BackgroundTransparency = 1
        hpTxt.TextColor3 = Color3.fromRGB(255, 80, 120)
        hpTxt.TextStrokeTransparency = 0.2
        hpTxt.Font = Enum.Font.GothamMedium
        hpTxt.TextSize = 11 * scale
        hpTxt.Parent = bbGui
    end

    if plr.Character then setupChar(plr.Character) end
    plr.CharacterAdded:Connect(setupChar)
end

