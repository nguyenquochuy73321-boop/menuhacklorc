local function applyEspToPlayer(plr)
    if plr == player then return end

    local function setupChar(char)
        if not char then return end

        local highlight = espFolder:FindFirstChild(plr.Name .. "_Highlight") or Instance.new("Highlight")
        highlight.Name = plr.Name .. "_Highlight"
        highlight.FillColor = Color3.fromRGB(180, 50, 255)
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.fromRGB(0, 255, 204)
        highlight.OutlineTransparency = 0
        highlight.Adornee = char
        highlight.Enabled = false
        highlight.Parent = espFolder

        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

